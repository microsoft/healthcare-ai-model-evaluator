ENV=development

# Storage endpoint (managed identity / Entra ID auth)
# Example for Azure Storage: https://<account>.blob.core.windows.net
AZURE_STORAGE_BLOB_ENDPOINT=

# gpt-4o (10^3 TPM)
AZURE_OPENAI_ENDPOINT=https://medbench-oai.openai.azure.com/
AZURE_OPENAI_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
