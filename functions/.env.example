CXRREPORTGEN_DEPLOYMENT=cxrreportgen
CXRREPORTGEN_VERSION=4
CXRREPORTGEN_ENDPOINT=https://fmmg-model-demos-cxrreportgen.westus3.inference.ml.azure.com/score
